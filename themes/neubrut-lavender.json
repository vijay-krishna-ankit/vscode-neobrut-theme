{
  "$schema": "vscode://schemas/color-theme",
  "name": "NeuBrut Lavender",
  "type": "light",
  "colors": {
    "focusBorder": "#7342A6",
    "foreground": "#514C5C",
    "descriptionForeground": "#605873",
    "errorForeground": "#A5263C",
    "selection.background": "#D9CBEF",
    "textLink.foreground": "#006D65",
    "textLink.activeForeground": "#7342A6",
    "activityBar.background": "#7342A6",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#EFE2FF",
    "activityBar.border": "#29243A",
    "activityBar.activeBorder": "#006D65",
    "sideBar.background": "#F4E8D2",
    "sideBar.foreground": "#514C5C",
    "sideBar.border": "#29243A",
    "sideBarTitle.foreground": "#514C5C",
    "sideBarSectionHeader.background": "#EBDDC5",
    "sideBarSectionHeader.foreground": "#514C5C",
    "sideBarSectionHeader.border": "#29243A",
    "editor.background": "#F4E8D2",
    "editor.foreground": "#645F70",
    "editor.lineHighlightBackground": "#EBDDC5",
    "editor.selectionBackground": "#D9CBEF",
    "editor.inactiveSelectionBackground": "#D9CBEF",
    "editorCursor.foreground": "#7342A6",
    "editorLineNumber.foreground": "#605873",
    "editorLineNumber.activeForeground": "#7342A6",
    "editorIndentGuide.background1": "#EBDDC5",
    "editorIndentGuide.activeBackground1": "#605873",
    "editorWhitespace.foreground": "#60587355",
    "editorBracketMatch.background": "#D9CBEF",
    "editorBracketMatch.border": "#7342A6",
    "editorGroup.border": "#29243A",
    "editorGroupHeader.tabsBackground": "#F4E8D2",
    "tab.activeBackground": "#7342A6",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "#F4E8D2",
    "tab.inactiveForeground": "#605873",
    "tab.border": "#60587355",
    "tab.activeBorderTop": "#00000000",
    "titleBar.activeBackground": "#EBDDC5",
    "titleBar.activeForeground": "#7342A6",
    "titleBar.inactiveBackground": "#F4E8D2",
    "titleBar.inactiveForeground": "#605873",
    "titleBar.border": "#29243A",
    "statusBar.background": "#7342A6",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#29243A",
    "statusBar.noFolderBackground": "#7342A6",
    "statusBar.noFolderForeground": "#FFFFFF",
    "statusBar.debuggingBackground": "#006D65",
    "statusBar.debuggingForeground": "#FFFFFF",
    "panel.background": "#FFF7E8",
    "panel.border": "#29243A",
    "panelTitle.activeForeground": "#514C5C",
    "panelTitle.inactiveForeground": "#605873",
    "panelTitle.activeBorder": "#7342A6",
    "input.background": "#FFF7E8",
    "input.foreground": "#514C5C",
    "input.border": "#29243A",
    "input.placeholderForeground": "#605873",
    "dropdown.background": "#EBDDC5",
    "dropdown.foreground": "#514C5C",
    "dropdown.border": "#29243A",
    "button.background": "#7342A6",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#006D65",
    "button.border": "#29243A",
    "list.activeSelectionBackground": "#D9CBEF",
    "list.activeSelectionForeground": "#514C5C",
    "list.inactiveSelectionBackground": "#EBDDC5",
    "list.hoverBackground": "#EBDDC5",
    "list.focusOutline": "#7342A6",
    "badge.background": "#006D65",
    "badge.foreground": "#FFFFFF",
    "editorWidget.background": "#EBDDC5",
    "editorWidget.foreground": "#514C5C",
    "editorWidget.border": "#29243A",
    "editorSuggestWidget.background": "#EBDDC5",
    "editorSuggestWidget.foreground": "#514C5C",
    "editorSuggestWidget.border": "#29243A",
    "editorSuggestWidget.selectedBackground": "#D9CBEF",
    "peekView.border": "#7342A6",
    "peekViewEditor.background": "#FFF7E8",
    "peekViewResult.background": "#EBDDC5",
    "peekViewTitle.background": "#F4E8D2",
    "terminal.background": "#FFF7E8",
    "terminal.foreground": "#514C5C",
    "terminalCursor.foreground": "#7342A6",
    "gitDecoration.modifiedResourceForeground": "#80500C",
    "gitDecoration.addedResourceForeground": "#006D65",
    "gitDecoration.deletedResourceForeground": "#814A70",
    "scrollbarSlider.background": "#60587355",
    "scrollbarSlider.hoverBackground": "#60587388",
    "scrollbarSlider.activeBackground": "#605873AA",
    "editorGroupHeader.border": "#00000000",
    "tab.activeBorder": "#00000000",
    "statusBar.noFolderBorder": "#29243A",
    "statusBarItem.hoverBackground": "#FFFFFF33",
    "statusBarItem.activeBackground": "#FFFFFF55",
    "tab.unfocusedActiveBackground": "#7342A6",
    "tab.unfocusedActiveForeground": "#FFFFFF",
    "tab.unfocusedActiveBorderTop": "#00000000",
    "tab.unfocusedActiveBorder": "#00000000",
    "modernEditorTab.activeBackground": "#7342A6",
    "modernEditorTab.activeForeground": "#FFFFFF",
    "modernEditorTab.activeHoverBackground": "#7342A6",
    "modernEditorTab.activeActionBackground": "#7342A6",
    "modernEditorTab.activeHoverActionBackground": "#7342A6",
    "modernEditorTab.inactiveBackground": "#F4E8D2",
    "modernTab.activeBackground": "#7342A6",
    "modernTab.activeForeground": "#FFFFFF",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editor.border": "#00000000",
    "breadcrumb.background": "#F4E8D2",
    "breadcrumb.foreground": "#514C5C",
    "breadcrumb.focusForeground": "#006D65",
    "breadcrumb.activeSelectionForeground": "#006D65",
    "breadcrumbPicker.background": "#EBDDC5",
    "modernUI.shellBackground": "#F4E8D2",
    "modernUI.inactiveShellBackground": "#F4E8D2",
    "commandCenter.foreground": "#514C5C",
    "commandCenter.activeForeground": "#514C5C",
    "commandCenter.inactiveForeground": "#605873"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#605873",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#006D65",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#006D65"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#006D65"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9B3357",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#006D65",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#645F70"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#006D65"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#006D65",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#80500C"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#645F70"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#A5263C",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Control flow and modifiers",
      "scope": [
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    }
  ]
}
