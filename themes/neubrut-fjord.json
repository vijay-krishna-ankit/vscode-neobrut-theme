{
  "$schema": "vscode://schemas/color-theme",
  "name": "NeuBrut Fjord",
  "type": "dark",
  "colors": {
    "focusBorder": "#8DAACB",
    "foreground": "#DFE8F0",
    "descriptionForeground": "#B2C1CE",
    "errorForeground": "#DC907A",
    "selection.background": "#40546B",
    "textLink.foreground": "#B6CB9B",
    "textLink.activeForeground": "#8DAACB",
    "activityBar.background": "#8DAACB",
    "activityBar.foreground": "#1C2938",
    "activityBar.inactiveForeground": "#3B526B",
    "activityBar.border": "#788C9E",
    "activityBar.activeBorder": "#CEB889",
    "sideBar.background": "#28333F",
    "sideBar.foreground": "#DFE8F0",
    "sideBar.border": "#788C9E",
    "sideBarTitle.foreground": "#DFE8F0",
    "sideBarSectionHeader.background": "#394B59",
    "sideBarSectionHeader.foreground": "#DFE8F0",
    "sideBarSectionHeader.border": "#788C9E",
    "editor.background": "#28333F",
    "editor.foreground": "#DFE8F0",
    "editor.lineHighlightBackground": "#394B59",
    "editor.selectionBackground": "#40546B",
    "editor.inactiveSelectionBackground": "#40546B",
    "editorCursor.foreground": "#8DAACB",
    "editorLineNumber.foreground": "#B2C1CE",
    "editorLineNumber.activeForeground": "#8DAACB",
    "editorIndentGuide.background1": "#394B59",
    "editorIndentGuide.activeBackground1": "#B2C1CE",
    "editorWhitespace.foreground": "#B2C1CE55",
    "editorBracketMatch.background": "#40546B",
    "editorBracketMatch.border": "#8DAACB",
    "editorGroup.border": "#788C9E",
    "editorGroupHeader.tabsBackground": "#303F4D",
    "tab.activeBackground": "#8DAACB",
    "tab.activeForeground": "#1C2938",
    "tab.inactiveBackground": "#303F4D",
    "tab.inactiveForeground": "#B2C1CE",
    "tab.border": "#B2C1CE55",
    "tab.activeBorderTop": "#00000000",
    "titleBar.activeBackground": "#394B59",
    "titleBar.activeForeground": "#8DAACB",
    "titleBar.inactiveBackground": "#303F4D",
    "titleBar.inactiveForeground": "#B2C1CE",
    "titleBar.border": "#788C9E",
    "statusBar.background": "#8DAACB",
    "statusBar.foreground": "#1C2938",
    "statusBar.border": "#788C9E",
    "statusBar.noFolderBackground": "#8DAACB",
    "statusBar.noFolderForeground": "#1C2938",
    "statusBar.debuggingBackground": "#CEB889",
    "statusBar.debuggingForeground": "#151515",
    "panel.background": "#28333F",
    "panel.border": "#788C9E",
    "panelTitle.activeForeground": "#DFE8F0",
    "panelTitle.inactiveForeground": "#B2C1CE",
    "panelTitle.activeBorder": "#8DAACB",
    "input.background": "#28333F",
    "input.foreground": "#DFE8F0",
    "input.border": "#788C9E",
    "input.placeholderForeground": "#B2C1CE",
    "dropdown.background": "#394B59",
    "dropdown.foreground": "#DFE8F0",
    "dropdown.border": "#788C9E",
    "button.background": "#8DAACB",
    "button.foreground": "#1C2938",
    "button.hoverBackground": "#CEB889",
    "button.border": "#788C9E",
    "list.activeSelectionBackground": "#40546B",
    "list.activeSelectionForeground": "#DFE8F0",
    "list.inactiveSelectionBackground": "#394B59",
    "list.hoverBackground": "#394B59",
    "list.focusOutline": "#8DAACB",
    "badge.background": "#CEB889",
    "badge.foreground": "#151515",
    "editorWidget.background": "#394B59",
    "editorWidget.foreground": "#DFE8F0",
    "editorWidget.border": "#788C9E",
    "editorSuggestWidget.background": "#394B59",
    "editorSuggestWidget.foreground": "#DFE8F0",
    "editorSuggestWidget.border": "#788C9E",
    "editorSuggestWidget.selectedBackground": "#40546B",
    "peekView.border": "#8DAACB",
    "peekViewEditor.background": "#28333F",
    "peekViewResult.background": "#394B59",
    "peekViewTitle.background": "#28333F",
    "terminal.background": "#28333F",
    "terminal.foreground": "#DFE8F0",
    "terminalCursor.foreground": "#8DAACB",
    "gitDecoration.modifiedResourceForeground": "#8DAACB",
    "gitDecoration.addedResourceForeground": "#B6CB9B",
    "gitDecoration.deletedResourceForeground": "#CEB889",
    "scrollbarSlider.background": "#B2C1CE55",
    "scrollbarSlider.hoverBackground": "#B2C1CE88",
    "scrollbarSlider.activeBackground": "#B2C1CEAA",
    "editorGroupHeader.border": "#00000000",
    "tab.activeBorder": "#00000000",
    "statusBar.noFolderBorder": "#788C9E",
    "statusBarItem.hoverBackground": "#00000026",
    "statusBarItem.activeBackground": "#00000044",
    "tab.unfocusedActiveBackground": "#8DAACB",
    "tab.unfocusedActiveForeground": "#1C2938",
    "tab.unfocusedActiveBorderTop": "#00000000",
    "tab.unfocusedActiveBorder": "#00000000",
    "modernEditorTab.activeBackground": "#8DAACB",
    "modernEditorTab.activeForeground": "#1C2938",
    "modernEditorTab.activeHoverBackground": "#8DAACB",
    "modernEditorTab.activeActionBackground": "#8DAACB",
    "modernEditorTab.activeHoverActionBackground": "#8DAACB",
    "modernEditorTab.inactiveBackground": "#303F4D",
    "modernTab.activeBackground": "#8DAACB",
    "modernTab.activeForeground": "#1C2938",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editor.border": "#00000000",
    "chat.requestBorder": "#788C9E",
    "chat.inputBorder": "#788C9E",
    "breadcrumb.background": "#303F4D",
    "breadcrumb.foreground": "#DFE8F0",
    "breadcrumb.focusForeground": "#B6CB9B",
    "breadcrumb.activeSelectionForeground": "#B6CB9B",
    "breadcrumbPicker.background": "#394B59",
    "modernUI.shellBackground": "#28333F",
    "modernUI.inactiveShellBackground": "#28333F",
    "commandCenter.foreground": "#DFE8F0",
    "commandCenter.activeForeground": "#DFE8F0",
    "commandCenter.inactiveForeground": "#B2C1CE"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B2C1CE",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#CEB889",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#B6CB9B"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#CEB889"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8DAACB",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B6CB9B",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#DFE8F0"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#CEB889"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#CEB889",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8DAACB"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#DFE8F0"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#DC907A",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Control flow and modifiers",
      "scope": [
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    }
  ]
}
