{
  "$schema": "vscode://schemas/color-theme",
  "name": "NeuBrut Fjord",
  "type": "dark",
  "colors": {
    "focusBorder": "#8ED5D0",
    "foreground": "#E8F1F1",
    "descriptionForeground": "#B9C8CD",
    "errorForeground": "#FF8C94",
    "selection.background": "#395A60",
    "textLink.foreground": "#B9D995",
    "textLink.activeForeground": "#8ED5D0",
    "activityBar.background": "#8ED5D0",
    "activityBar.foreground": "#172D31",
    "activityBar.inactiveForeground": "#244E50",
    "activityBar.border": "#78999B",
    "activityBar.activeBorder": "#F1A0A7",
    "sideBar.background": "#473630",
    "sideBar.foreground": "#E8F1F1",
    "sideBar.border": "#78999B",
    "sideBarTitle.foreground": "#E8F1F1",
    "sideBarSectionHeader.background": "#394B59",
    "sideBarSectionHeader.foreground": "#E8F1F1",
    "sideBarSectionHeader.border": "#78999B",
    "editor.background": "#35292F",
    "editor.foreground": "#E8F1F1",
    "editor.lineHighlightBackground": "#394B59",
    "editor.selectionBackground": "#395A60",
    "editor.inactiveSelectionBackground": "#395A60",
    "editorCursor.foreground": "#8ED5D0",
    "editorLineNumber.foreground": "#B9C8CD",
    "editorLineNumber.activeForeground": "#8ED5D0",
    "editorIndentGuide.background1": "#394B59",
    "editorIndentGuide.activeBackground1": "#B9C8CD",
    "editorWhitespace.foreground": "#B9C8CD55",
    "editorBracketMatch.background": "#395A60",
    "editorBracketMatch.border": "#8ED5D0",
    "editorGroup.border": "#78999B",
    "editorGroupHeader.tabsBackground": "#303F4D",
    "tab.activeBackground": "#F1A0A7",
    "tab.activeForeground": "#151515",
    "tab.inactiveBackground": "#303F4D",
    "tab.inactiveForeground": "#B9C8CD",
    "tab.border": "#B9C8CD55",
    "tab.activeBorderTop": "#00000000",
    "titleBar.activeBackground": "#394B59",
    "titleBar.activeForeground": "#8ED5D0",
    "titleBar.inactiveBackground": "#303F4D",
    "titleBar.inactiveForeground": "#B9C8CD",
    "titleBar.border": "#78999B",
    "statusBar.background": "#8ED5D0",
    "statusBar.foreground": "#172D31",
    "statusBar.border": "#78999B",
    "statusBar.noFolderBackground": "#8ED5D0",
    "statusBar.noFolderForeground": "#172D31",
    "statusBar.debuggingBackground": "#F1A0A7",
    "statusBar.debuggingForeground": "#151515",
    "panel.background": "#35292F",
    "panel.border": "#78999B",
    "panelTitle.activeForeground": "#E8F1F1",
    "panelTitle.inactiveForeground": "#B9C8CD",
    "panelTitle.activeBorder": "#8ED5D0",
    "input.background": "#35292F",
    "input.foreground": "#E8F1F1",
    "input.border": "#78999B",
    "input.placeholderForeground": "#B9C8CD",
    "dropdown.background": "#394B59",
    "dropdown.foreground": "#E8F1F1",
    "dropdown.border": "#78999B",
    "button.background": "#8ED5D0",
    "button.foreground": "#172D31",
    "button.hoverBackground": "#F1A0A7",
    "button.border": "#78999B",
    "list.activeSelectionBackground": "#395A60",
    "list.activeSelectionForeground": "#E8F1F1",
    "list.inactiveSelectionBackground": "#394B59",
    "list.hoverBackground": "#394B59",
    "list.focusOutline": "#8ED5D0",
    "badge.background": "#F1A0A7",
    "badge.foreground": "#151515",
    "editorWidget.background": "#394B59",
    "editorWidget.foreground": "#E8F1F1",
    "editorWidget.border": "#78999B",
    "editorSuggestWidget.background": "#394B59",
    "editorSuggestWidget.foreground": "#E8F1F1",
    "editorSuggestWidget.border": "#78999B",
    "editorSuggestWidget.selectedBackground": "#395A60",
    "peekView.border": "#8ED5D0",
    "peekViewEditor.background": "#35292F",
    "peekViewResult.background": "#394B59",
    "peekViewTitle.background": "#473630",
    "terminal.background": "#35292F",
    "terminal.foreground": "#E8F1F1",
    "terminalCursor.foreground": "#8ED5D0",
    "gitDecoration.modifiedResourceForeground": "#8ED5D0",
    "gitDecoration.addedResourceForeground": "#B9D995",
    "gitDecoration.deletedResourceForeground": "#F1A0A7",
    "scrollbarSlider.background": "#B9C8CD55",
    "scrollbarSlider.hoverBackground": "#B9C8CD88",
    "scrollbarSlider.activeBackground": "#B9C8CDAA",
    "editorGroupHeader.border": "#00000000",
    "tab.activeBorder": "#00000000",
    "statusBar.noFolderBorder": "#78999B",
    "statusBarItem.hoverBackground": "#00000026",
    "statusBarItem.activeBackground": "#00000044",
    "tab.unfocusedActiveBackground": "#F1A0A7",
    "tab.unfocusedActiveForeground": "#151515",
    "tab.unfocusedActiveBorderTop": "#00000000",
    "tab.unfocusedActiveBorder": "#00000000",
    "modernEditorTab.activeBackground": "#F1A0A7",
    "modernEditorTab.activeForeground": "#151515",
    "modernEditorTab.activeHoverBackground": "#F1A0A7",
    "modernEditorTab.activeActionBackground": "#F1A0A7",
    "modernEditorTab.activeHoverActionBackground": "#F1A0A7",
    "modernEditorTab.inactiveBackground": "#303F4D",
    "modernTab.activeBackground": "#F1A0A7",
    "modernTab.activeForeground": "#151515",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editor.border": "#00000000",
    "chat.requestBorder": "#78999B",
    "chat.inputBorder": "#78999B",
    "breadcrumb.background": "#303F4D",
    "breadcrumb.foreground": "#E8F1F1",
    "breadcrumb.focusForeground": "#B9D995",
    "breadcrumb.activeSelectionForeground": "#B9D995",
    "breadcrumbPicker.background": "#394B59",
    "modernUI.shellBackground": "#473630",
    "modernUI.inactiveShellBackground": "#473630",
    "commandCenter.foreground": "#E8F1F1",
    "commandCenter.activeForeground": "#E8F1F1",
    "commandCenter.inactiveForeground": "#B9C8CD"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B9C8CD",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F1A0A7",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#B9D995"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#F1A0A7"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8ED5D0",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B9D995",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#E8F1F1"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#F1A0A7"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F1A0A7",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8ED5D0"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#E8F1F1"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF8C94",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Control flow and modifiers",
      "scope": [
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    }
  ]
}
