{
  "$schema": "vscode://schemas/color-theme",
  "name": "NeuBrut Verdigris",
  "type": "dark",
  "colors": {
    "focusBorder": "#79B4AA",
    "foreground": "#DEE3DF",
    "descriptionForeground": "#ABB8B1",
    "errorForeground": "#D58C72",
    "selection.background": "#374D4B",
    "textLink.foreground": "#85BCBC",
    "textLink.activeForeground": "#79B4AA",
    "activityBar.background": "#79B4AA",
    "activityBar.foreground": "#151515",
    "activityBar.inactiveForeground": "#334C47",
    "activityBar.border": "#899B94",
    "activityBar.activeBorder": "#C9B17B",
    "sideBar.background": "#252D28",
    "sideBar.foreground": "#DEE3DF",
    "sideBar.border": "#899B94",
    "sideBarTitle.foreground": "#DEE3DF",
    "sideBarSectionHeader.background": "#303B37",
    "sideBarSectionHeader.foreground": "#DEE3DF",
    "sideBarSectionHeader.border": "#899B94",
    "editor.background": "#252D28",
    "editor.foreground": "#DEE3DF",
    "editor.lineHighlightBackground": "#303B37",
    "editor.selectionBackground": "#374D4B",
    "editor.inactiveSelectionBackground": "#374D4B",
    "editorCursor.foreground": "#79B4AA",
    "editorLineNumber.foreground": "#ABB8B1",
    "editorLineNumber.activeForeground": "#79B4AA",
    "editorIndentGuide.background1": "#303B37",
    "editorIndentGuide.activeBackground1": "#ABB8B1",
    "editorWhitespace.foreground": "#ABB8B155",
    "editorBracketMatch.background": "#374D4B",
    "editorBracketMatch.border": "#79B4AA",
    "editorGroup.border": "#899B94",
    "editorGroupHeader.tabsBackground": "#29332F",
    "tab.activeBackground": "#79B4AA",
    "tab.activeForeground": "#151515",
    "tab.inactiveBackground": "#29332F",
    "tab.inactiveForeground": "#ABB8B1",
    "tab.border": "#ABB8B155",
    "tab.activeBorderTop": "#00000000",
    "titleBar.activeBackground": "#303B37",
    "titleBar.activeForeground": "#79B4AA",
    "titleBar.inactiveBackground": "#29332F",
    "titleBar.inactiveForeground": "#ABB8B1",
    "titleBar.border": "#899B94",
    "statusBar.background": "#79B4AA",
    "statusBar.foreground": "#151515",
    "statusBar.border": "#899B94",
    "statusBar.noFolderBackground": "#79B4AA",
    "statusBar.noFolderForeground": "#151515",
    "statusBar.debuggingBackground": "#C9B17B",
    "statusBar.debuggingForeground": "#151515",
    "panel.background": "#252D28",
    "panel.border": "#899B94",
    "panelTitle.activeForeground": "#DEE3DF",
    "panelTitle.inactiveForeground": "#ABB8B1",
    "panelTitle.activeBorder": "#79B4AA",
    "input.background": "#252D28",
    "input.foreground": "#DEE3DF",
    "input.border": "#899B94",
    "input.placeholderForeground": "#ABB8B1",
    "dropdown.background": "#303B37",
    "dropdown.foreground": "#DEE3DF",
    "dropdown.border": "#899B94",
    "button.background": "#79B4AA",
    "button.foreground": "#151515",
    "button.hoverBackground": "#C9B17B",
    "button.border": "#899B94",
    "list.activeSelectionBackground": "#374D4B",
    "list.activeSelectionForeground": "#DEE3DF",
    "list.inactiveSelectionBackground": "#303B37",
    "list.hoverBackground": "#303B37",
    "list.focusOutline": "#79B4AA",
    "badge.background": "#C9B17B",
    "badge.foreground": "#151515",
    "editorWidget.background": "#303B37",
    "editorWidget.foreground": "#DEE3DF",
    "editorWidget.border": "#899B94",
    "editorSuggestWidget.background": "#303B37",
    "editorSuggestWidget.foreground": "#DEE3DF",
    "editorSuggestWidget.border": "#899B94",
    "editorSuggestWidget.selectedBackground": "#374D4B",
    "peekView.border": "#79B4AA",
    "peekViewEditor.background": "#252D28",
    "peekViewResult.background": "#303B37",
    "peekViewTitle.background": "#252D28",
    "terminal.background": "#252D28",
    "terminal.foreground": "#DEE3DF",
    "terminalCursor.foreground": "#79B4AA",
    "gitDecoration.modifiedResourceForeground": "#79B4AA",
    "gitDecoration.addedResourceForeground": "#85BCBC",
    "gitDecoration.deletedResourceForeground": "#C9B17B",
    "scrollbarSlider.background": "#ABB8B155",
    "scrollbarSlider.hoverBackground": "#ABB8B188",
    "scrollbarSlider.activeBackground": "#ABB8B1AA",
    "editorGroupHeader.border": "#00000000",
    "tab.activeBorder": "#00000000",
    "statusBar.noFolderBorder": "#899B94",
    "statusBarItem.hoverBackground": "#00000026",
    "statusBarItem.activeBackground": "#00000044",
    "tab.unfocusedActiveBackground": "#79B4AA",
    "tab.unfocusedActiveForeground": "#151515",
    "tab.unfocusedActiveBorderTop": "#00000000",
    "tab.unfocusedActiveBorder": "#00000000",
    "modernEditorTab.activeBackground": "#79B4AA",
    "modernEditorTab.activeForeground": "#151515",
    "modernEditorTab.activeHoverBackground": "#79B4AA",
    "modernEditorTab.activeActionBackground": "#79B4AA",
    "modernEditorTab.activeHoverActionBackground": "#79B4AA",
    "modernEditorTab.inactiveBackground": "#29332F",
    "modernTab.activeBackground": "#79B4AA",
    "modernTab.activeForeground": "#151515",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editor.border": "#00000000",
    "breadcrumb.background": "#29332F",
    "breadcrumb.foreground": "#DEE3DF",
    "breadcrumb.focusForeground": "#85BCBC",
    "breadcrumb.activeSelectionForeground": "#85BCBC",
    "breadcrumbPicker.background": "#303B37",
    "modernUI.shellBackground": "#252D28",
    "modernUI.inactiveShellBackground": "#252D28",
    "commandCenter.foreground": "#DEE3DF",
    "commandCenter.activeForeground": "#DEE3DF",
    "commandCenter.inactiveForeground": "#ABB8B1"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ABB8B1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C9B17B",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#85BCBC"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#C9B17B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method",
        "support.function.builtin",
        "variable.function",
        "entity.name.function.call"
      ],
      "settings": {
        "foreground": "#79B4AA",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "support.type.primitive",
        "entity.name.struct",
        "entity.name.interface",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#85BCBC",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#DEE3DF"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C9B17B"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#C9B17B",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#79B4AA"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#DEE3DF"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#D58C72",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key string.unquoted"
      ],
      "settings": {
        "foreground": "#79B4AA"
      }
    },
    {
      "name": "Constants and enum members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#C9B17B"
      }
    },
    {
      "name": "Escapes and format placeholders",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#79B4AA"
      }
    },
    {
      "name": "Control flow and modifiers",
      "scope": [
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#85BCBC",
    "type": "#85BCBC",
    "class": "#85BCBC",
    "interface": "#85BCBC",
    "struct": "#85BCBC",
    "enum": "#85BCBC",
    "typeParameter": "#85BCBC",
    "function": "#79B4AA",
    "method": "#79B4AA",
    "macro": "#79B4AA",
    "variable": "#DEE3DF",
    "parameter": "#C9B17B",
    "property": "#79B4AA",
    "enumMember": "#C9B17B",
    "variable.readonly": "#C9B17B",
    "property.readonly": "#C9B17B",
    "keyword": "#C9B17B",
    "string": "#85BCBC",
    "number": "#C9B17B",
    "event": "#79B4AA",
    "decorator": "#79B4AA",
    "label": "#C9B17B"
  }
}
