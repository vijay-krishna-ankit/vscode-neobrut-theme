{
  "$schema": "vscode://schemas/color-theme",
  "name": "NeuBrut Paper",
  "type": "light",
  "colors": {
    "focusBorder": "#B84C61",
    "foreground": "#4A4743",
    "descriptionForeground": "#625C54",
    "errorForeground": "#B31634",
    "selection.background": "#F9D975",
    "textLink.foreground": "#006D77",
    "textLink.activeForeground": "#B84C61",
    "activityBar.background": "#B84C61",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#FFE3E9",
    "activityBar.border": "#191919",
    "activityBar.activeBorder": "#6A3FC0",
    "sideBar.background": "#F8EED9",
    "sideBar.foreground": "#4A4743",
    "sideBar.border": "#191919",
    "sideBarTitle.foreground": "#4A4743",
    "sideBarSectionHeader.background": "#F1E6CE",
    "sideBarSectionHeader.foreground": "#4A4743",
    "sideBarSectionHeader.border": "#191919",
    "editor.background": "#F8EED9",
    "editor.foreground": "#625E59",
    "editor.lineHighlightBackground": "#F1E6CE",
    "editor.selectionBackground": "#F9D975",
    "editor.inactiveSelectionBackground": "#F9D975",
    "editorCursor.foreground": "#B84C61",
    "editorLineNumber.foreground": "#625C54",
    "editorLineNumber.activeForeground": "#B84C61",
    "editorIndentGuide.background1": "#F1E6CE",
    "editorIndentGuide.activeBackground1": "#625C54",
    "editorWhitespace.foreground": "#625C5455",
    "editorBracketMatch.background": "#F9D975",
    "editorBracketMatch.border": "#B84C61",
    "editorGroup.border": "#191919",
    "editorGroupHeader.tabsBackground": "#F8EED9",
    "tab.activeBackground": "#B84C61",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "#F8EED9",
    "tab.inactiveForeground": "#625C54",
    "tab.border": "#625C5455",
    "tab.activeBorderTop": "#00000000",
    "titleBar.activeBackground": "#F1E6CE",
    "titleBar.activeForeground": "#B84C61",
    "titleBar.inactiveBackground": "#F8EED9",
    "titleBar.inactiveForeground": "#625C54",
    "titleBar.border": "#191919",
    "statusBar.background": "#B84C61",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#191919",
    "statusBar.noFolderBackground": "#B84C61",
    "statusBar.noFolderForeground": "#FFFFFF",
    "statusBar.debuggingBackground": "#6A3FC0",
    "statusBar.debuggingForeground": "#FFFFFF",
    "panel.background": "#FFF8E7",
    "panel.border": "#191919",
    "panelTitle.activeForeground": "#4A4743",
    "panelTitle.inactiveForeground": "#625C54",
    "panelTitle.activeBorder": "#B84C61",
    "input.background": "#FFF8E7",
    "input.foreground": "#4A4743",
    "input.border": "#191919",
    "input.placeholderForeground": "#625C54",
    "dropdown.background": "#F1E6CE",
    "dropdown.foreground": "#4A4743",
    "dropdown.border": "#191919",
    "button.background": "#B84C61",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#6A3FC0",
    "button.border": "#191919",
    "list.activeSelectionBackground": "#F9D975",
    "list.activeSelectionForeground": "#4A4743",
    "list.inactiveSelectionBackground": "#F1E6CE",
    "list.hoverBackground": "#F1E6CE",
    "list.focusOutline": "#B84C61",
    "badge.background": "#6A3FC0",
    "badge.foreground": "#FFFFFF",
    "editorWidget.background": "#F1E6CE",
    "editorWidget.foreground": "#4A4743",
    "editorWidget.border": "#191919",
    "editorSuggestWidget.background": "#F1E6CE",
    "editorSuggestWidget.foreground": "#4A4743",
    "editorSuggestWidget.border": "#191919",
    "editorSuggestWidget.selectedBackground": "#F9D975",
    "peekView.border": "#B84C61",
    "peekViewEditor.background": "#FFF8E7",
    "peekViewResult.background": "#F1E6CE",
    "peekViewTitle.background": "#F8EED9",
    "terminal.background": "#FFF8E7",
    "terminal.foreground": "#4A4743",
    "terminalCursor.foreground": "#B84C61",
    "gitDecoration.modifiedResourceForeground": "#9A6200",
    "gitDecoration.addedResourceForeground": "#006D77",
    "gitDecoration.deletedResourceForeground": "#6A3FC0",
    "scrollbarSlider.background": "#625C5455",
    "scrollbarSlider.hoverBackground": "#625C5488",
    "scrollbarSlider.activeBackground": "#625C54AA",
    "editorGroupHeader.border": "#00000000",
    "tab.activeBorder": "#00000000",
    "statusBar.noFolderBorder": "#191919",
    "statusBarItem.hoverBackground": "#FFFFFF33",
    "statusBarItem.activeBackground": "#FFFFFF55",
    "tab.unfocusedActiveBackground": "#B84C61",
    "tab.unfocusedActiveForeground": "#FFFFFF",
    "tab.unfocusedActiveBorderTop": "#00000000",
    "tab.unfocusedActiveBorder": "#00000000",
    "modernEditorTab.activeBackground": "#B84C61",
    "modernEditorTab.activeForeground": "#FFFFFF",
    "modernEditorTab.activeHoverBackground": "#B84C61",
    "modernEditorTab.activeActionBackground": "#B84C61",
    "modernEditorTab.activeHoverActionBackground": "#B84C61",
    "modernEditorTab.inactiveBackground": "#F8EED9",
    "modernTab.activeBackground": "#B84C61",
    "modernTab.activeForeground": "#FFFFFF",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editor.border": "#00000000",
    "breadcrumb.background": "#F8EED9",
    "breadcrumb.foreground": "#4A4743",
    "breadcrumb.focusForeground": "#006D77",
    "breadcrumb.activeSelectionForeground": "#006D77",
    "breadcrumbPicker.background": "#F1E6CE",
    "modernUI.shellBackground": "#F8EED9",
    "modernUI.inactiveShellBackground": "#F8EED9",
    "commandCenter.foreground": "#4A4743",
    "commandCenter.activeForeground": "#4A4743",
    "commandCenter.inactiveForeground": "#625C54"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#625C54",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6A3FC0",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#006D77"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#6A3FC0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#A32343",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#006D77",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#625E59"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#6A3FC0"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6A3FC0",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8B4D00"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#625E59"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#B31634",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Control flow and modifiers",
      "scope": [
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    }
  ]
}
